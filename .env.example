# Copy to .env.local locally; add the same keys in Vercel → Settings → Environment Variables.
# Your live portfolio URL (no trailing slash), e.g. a custom domain later.
NEXT_PUBLIC_SITE_URL=https://mohitsrma.vercel.app

# Optional: email contact-form messages to you via Resend (https://resend.com, free).
# Sign up with mohitsrma7014@gmail.com — the default sender works without owning a domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=mohitsrma7014@gmail.com

# Optional: Google Search Console verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
